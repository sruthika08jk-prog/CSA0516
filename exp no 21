
% Facts
parent(john, mary).
parent(mary, sam).
parent(sam, david).

% Rule 1: Grandparent relationship
grandparent(X, Z) :-
    parent(X, Y),
    parent(Y, Z).

% Rule 2: Ancestor relationship
ancestor(X, Y) :-
    parent(X, Y).

ancestor(X, Y) :-
    parent(X, Z),
    ancestor(Z, Y).

% Main program
main :-
    write('Backward Chaining Program'), nl,
    write('Grandparent: '),
    (grandparent(john, sam) ->
        write('John is grandparent of Sam')
    ;
        write('Not found')
    ), nl,
    write('Ancestor: '),
    (ancestor(john, david) ->
        write('John is ancestor of David')
    ;
        write('Not found')
    ), nl.
