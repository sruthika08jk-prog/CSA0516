
from sklearn.tree import DecisionTreeClassifier

# Training data
X = [[1, 2], [2, 3], [3, 4], [6, 7], [7, 8], [8, 9]]
y = [0, 0, 0, 1, 1, 1]

# Create Decision Tree
model = DecisionTreeClassifier()
model.fit(X, y)

# Prediction
prediction = model.predict([[5, 6]])

print("Predicted Class:", prediction[0])
