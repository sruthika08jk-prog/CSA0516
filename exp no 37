import pandas as pd
from sklearn.metrics.pairwise import cosine_similarity

# User-item rating data
data = {
    'Movie1': [5, 4, 0, 0],
    'Movie2': [4, 0, 0, 2],
    'Movie3': [0, 5, 4, 0],
    'Movie4': [0, 0, 5, 4]
}

df = pd.DataFrame(data, index=['User1', 'User2', 'User3', 'User4'])

# Calculate user similarity
similarity = cosine_similarity(df)
similarity_df = pd.DataFrame(
    similarity, index=df.index, columns=df.index
)

# Recommend movies for User1
user = 'User1'
scores = similarity_df.loc[user] @ df
scores = scores / similarity_df.loc[user].sum()

# Remove already watched movies
scores = scores[df.loc[user] == 0]

print("Recommendations for", user)
print(scores.sort_values(ascending=False))
